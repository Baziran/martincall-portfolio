MARTINCALL_POSTGRES_DB=martincall
MARTINCALL_POSTGRES_USER=martincall
MARTINCALL_POSTGRES_PASSWORD=replace_with_a_strong_generated_password
MARTINCALL_BIND_ADDRESS=172.29.172.1
MARTINCALL_DB_MEMORY=1536m
MARTINCALL_DB_CPUS=1.0
MARTINCALL_DB_SHM=256mb
MARTINCALL_APP_MEMORY=768m
MARTINCALL_APP_CPUS=1.0
MARTINCALL_APP_IMAGE_TAG=hetzner-pilot
MARTINCALL_DATA_ROOT=/opt/martincall/shared/data
IB_GATEWAY_MEMORY=768m
IB_GATEWAY_CPUS=1.0
IB_GATEWAY_ENV_FILE=/opt/martincall/shared/gateway.env
IB_GATEWAY_PASSWORD_FILE=/opt/martincall/shared/secrets/ibkr_password
IB_GATEWAY_VNC_PASSWORD_FILE=/opt/martincall/shared/secrets/vnc_password
AEF_IBKR_PORT=4003
AEF_IBKR_GEX_PORT=4003
AEF_IBKR_MARKET_DATA_TYPE=1
AEF_IBKR_GEX_MARKET_DATA_TYPE=3
AEF_RESEARCH_CAPTURE_ENABLED=true
AEF_RESEARCH_CAPTURE_INSTRUMENT_IDS=["ibkr|future_root|ES|CME|USD|ES"]
AEF_RESEARCH_CAPTURE_TIMEFRAME=5m
AEF_RESEARCH_CAPTURE_RECONCILE_SECONDS=15
BUILD_GIT_SHA=replace_with_release_revision
BUILD_DATE=replace_with_utc_build_date
BUILD_VERSION=1.5.0
