# Host-only Discord Desktop RPC companion configuration.
# Copy to secrets/discord_signals_companion.env and chmod 600 that file.
# Never put a normal Discord user token here.
AEF_DISCORD_RPC_CLIENT_ID=
AEF_DISCORD_RPC_CLIENT_SECRET=
AEF_DISCORD_RPC_REDIRECT_URI=http://127.0.0.1:8787/discord-rpc
AEF_DISCORD_SIGNALS_CHANNEL_IDS=
AEF_DISCORD_SIGNALS_AUTHOR_ID=
AEF_DISCORD_SIGNALS_BRIDGE_SECRET=
AEF_DISCORD_SIGNALS_TERMINAL_URL=http://127.0.0.1:8000
AEF_DISCORD_SIGNALS_HISTORY_LIMIT=500
AEF_DISCORD_SIGNALS_SNAPSHOT_SECONDS=30
AEF_DISCORD_SIGNALS_REQUEST_TIMEOUT_SECONDS=8
AEF_DISCORD_SIGNALS_GATE_POLL_SECONDS=2
