MARTINCALL_POSTGRES_DB=martincall
MARTINCALL_POSTGRES_USER=martincall
# Read-only analysis processes, prestarted before provider transports (1..8).
# This is NOT the number of application/uvicorn writers. Nettop: 2 workers.
AEF_MARKET_ANALYSIS_WORKERS=1
# Required: replace this placeholder with a strong random password before startup.
MARTINCALL_POSTGRES_PASSWORD=replace_with_a_strong_random_password
AEF_DATABASE_URL=postgresql://martincall:replace_with_a_strong_random_password@127.0.0.1:5432/martincall
# Optional tick profile: exact durable instrument_id from the qualified watchlist row.
MARTINCALL_TICK_INSTRUMENT_ID=
AEF_IBKR_MARKET_DATA_TYPE=1
AEF_IBKR_GEX_HOST=host.docker.internal
AEF_IBKR_GEX_PORT=7497
AEF_IBKR_GEX_CLIENT_ID=3017
AEF_IBKR_GEX_LIVE_CLIENT_ID=3117
AEF_IBKR_GEX_MARKET_DATA_TYPE=3
AEF_IBKR_GEX_BATCH_SIZE=8
AEF_IBKR_GEX_WAIT_SECONDS=2.0
AEF_IBKR_GEX_BATCH_PAUSE_SECONDS=0.25
AEF_IBKR_GEX_TIMEOUT_SECONDS=65.0
AEF_IBKR_CONTRACT_CACHE_SIZE=256
# Persist provider-qualified quote history for backend read models.
AEF_QUOTE_SNAPSHOT_SECONDS=5
# Watchlist-wide closed-session history maintenance. Each admitted task is still
# bounded in code to the latest 31-day window and at most 512 provider slots.
# New history work is admitted only during this DST-aware local wall-clock window;
# provider calendar refresh and recovery continue outside it.
AEF_CLOSED_SESSION_MAINTENANCE_ENABLED=true
AEF_CLOSED_SESSION_MAINTENANCE_TIMEZONE=Asia/Jerusalem
AEF_CLOSED_SESSION_MAINTENANCE_START_LOCAL=00:05
AEF_CLOSED_SESSION_MAINTENANCE_END_LOCAL=01:00
AEF_CLOSED_SESSION_MAINTENANCE_ACTIVE_POLL_SECONDS=30
AEF_CLOSED_SESSION_MAINTENANCE_IDLE_POLL_SECONDS=1800
AEF_CLOSED_SESSION_MAINTENANCE_REPAIR_TIMEOUT_SECONDS=30
AEF_CLOSED_SESSION_MAINTENANCE_MAX_PROVIDER_ADMISSIONS=1
AEF_CLOSED_SESSION_MAINTENANCE_ADMISSION_WINDOW_SECONDS=43200
AEF_CLOSED_SESSION_MAINTENANCE_MAX_PROVIDER_ADMISSIONS_PER_WINDOW=32
AEF_CLOSED_SESSION_MAINTENANCE_FAILURE_THRESHOLD=3
AEF_CLOSED_SESSION_MAINTENANCE_BREAKER_BACKOFF_SECONDS=21600
# Autonomous prospective research capture. Use only exact durable instrument IDs.
AEF_RESEARCH_CAPTURE_ENABLED=false
AEF_RESEARCH_CAPTURE_INSTRUMENT_IDS=[]
AEF_RESEARCH_CAPTURE_TIMEFRAME=5m
AEF_RESEARCH_CAPTURE_RECONCILE_SECONDS=15
# Optional stable host path mounted into the app and operator containers at /data.
MARTINCALL_DATA_ROOT=../data
# Optional exact provider-qualified VIX instrument_id used by volatility context.
AEF_VIX_INSTRUMENT_ID=
# Put AEF_TINVEST_TOKEN only in the ignored secrets/martincall_runtime.env file.
# Optional kill switch; defaults to true when bot token and chat id are set.
# Price alerts still deliver when configured (same path as Telegram test).
AEF_TELEGRAM_ENABLED=
AEF_TELEGRAM_BOT_TOKEN=
AEF_TELEGRAM_CHAT_ID=
AEF_TELEGRAM_TIMEOUT_SECONDS=5
AEF_TELEGRAM_INTERACTIVE_ENABLED=false
AEF_TELEGRAM_INTERACTIVE_POLL_TIMEOUT_SECONDS=25
# Discord Signals receives official Discord Desktop RPC events from the local
# package companion. Keep the bridge secret in AEF_SECRET_FILE.
AEF_DISCORD_SIGNALS_ENABLED=
AEF_DISCORD_SIGNALS_CHANNEL_IDS=
AEF_DISCORD_SIGNALS_AUTHOR_ID=
AEF_DISCORD_SIGNALS_AUTHOR_NAME=GAA
AEF_DISCORD_SIGNALS_BRIDGE_SECRET=
AEF_DISCORD_SIGNALS_RETENTION_HOURS=72
AEF_DISCORD_SIGNALS_HISTORY_LIMIT=500
